# Token phòng headless (lấy tại https://www.haxball.com/headlesstoken)
HAXBALL_TOKEN=

# Auth của Super Admin (copy dòng Public ID tại https://www.haxball.com/playerauth, nhiều người cách nhau bằng dấu phẩy)
SUPER_ADMIN_AUTHS=

# Link server Discord (hiển thị khi gõ !discord)
DISCORD_LINK=

# --- Webhook Discord (bỏ trống nếu không dùng) ---

# Gửi kết quả trận đấu & file replay .hbr2
DISCORD_WEBHOOK=

# Ghi log biến động coins và gems (chống hack/soi giao dịch)
DISCORD_COIN_LOG_WEBHOOK=

# Ghi log vào/ra room, kick, ban
DISCORD_LOG_WEBHOOK=

# Nhận tin báo lỗi khi người chơi gõ !report
DISCORD_REPORT_WEBHOOK=

# ID Discord của admin để bot tag khi có !report (cách nhau bằng dấu phẩy)
REPORT_TAG_USER_IDS=

# Đẩy tin nhắn chat trong room lên Discord
DISCORD_CHAT_WEBHOOK=

# --- Discord Bot 2 chiều (bỏ trống nếu không dùng) ---

# Token bot Discord để gửi tin nhắn từ Discord vào room
DISCORD_BOT_TOKEN=

# ID kênh chat Discord để nhắn vào room
DISCORD_CHANNEL_ID=
