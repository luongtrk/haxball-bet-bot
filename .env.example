# =========================================================================
# ⚽ CẤU HÌNH HAXBALL BOT
# =========================================================================
# Token Haxball headless (Lấy token mới mỗi lần chạy tại: https://www.haxball.com/headlesstoken)
HAXBALL_TOKEN=

# Danh sách Auth của Super Admin (phân tách bằng dấu phẩy)
# Ví dụ: auth1,auth2
SUPER_ADMIN_AUTHS=

# Link mời tham gia Server Discord của phòng (dùng cho lệnh !discord và tin nhắn chào mừng)
# Ví dụ: https://discord.gg/abcxyz
DISCORD_LINK=

# =========================================================================
# 📢 CẤU HÌNH DISCORD WEBHOOKS (Tùy chọn)
# =========================================================================
# 1. Webhook kết quả trận đấu & Replay: Gửi thống kê trận đấu và đính kèm file replay .hbr2
DISCORD_WEBHOOK=

# 2. Webhook lịch sử tiền (Coins & Gems): Ghi log giao dịch nạp, chuyển tiền, thắng thua minigame
DISCORD_COIN_LOG_WEBHOOK=

# 3. Webhook nhật ký phòng: Ghi log người chơi vào/ra, kick, ban, cảnh cáo
DISCORD_LOG_WEBHOOK=

# 4. Webhook báo cáo lỗi (!report): Nhận phản ánh từ người chơi khi gặp lỗi hoặc phá hoại
DISCORD_REPORT_WEBHOOK=

# Danh sách Discord User ID của Admin cần tag khi có report (phân tách bằng dấu phẩy)
# Ví dụ: 123456789012345678,987654321098765432
REPORT_TAG_USER_IDS=

# 5. Webhook theo dõi chat: Gửi tin nhắn chat trong phòng lên Discord khi bật lệnh !xemchat
DISCORD_CHAT_WEBHOOK=

# =========================================================================
# 🤖 CẤU HÌNH DISCORD BOT 2 CHIỀU (Tùy chọn)
# =========================================================================
# Token của Bot Discord để nhận lệnh từ Discord và nói chuyện trực tiếp vào phòng Haxball
DISCORD_BOT_TOKEN=

# ID của kênh Discord dùng để tương tác 2 chiều với phòng
DISCORD_CHANNEL_ID=
